{
  "version": 2,
  "builds": [
    {
      "src": "src/web/app.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/web/app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "* * * * *"
    }
  ]
}
